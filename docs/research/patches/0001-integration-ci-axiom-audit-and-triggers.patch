         run: |
           set -euo pipefail
-          cat > AxiomAudit.lean <<'EOF'
-          import Erdos302.Asymptotic
-          #print axioms Erdos302.Generated.repeatedThresholdLevelAt
-          #print axioms Erdos302.Packing.prefix_omission_certificate
-          #print axioms Erdos302.Asymptotic.erdos302Certificate_holds
-          #print axioms Erdos302.Asymptotic.erdos_302_upper_140803024_163562355
-          #print axioms Erdos302.Asymptotic.f302_upper_140803024_163562355
-          EOF
-          lake env lean -s 1048576 AxiomAudit.lean 2>&1 | tee AxiomAudit.log
+          lake env lean -s 1048576 Erdos302/Axioms.lean 2>&1 | tee AxiomAudit.log
           python3 - <<'PY'
