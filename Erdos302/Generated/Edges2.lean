def edgeValid2 (e : ℕ × ℕ × ℕ) : Bool :=
  let a := e.1
  let b := e.2.1
  let c := e.2.2
  decide (1 < a ∧ 1 < b ∧ 1 < c ∧ a ∣ Q ∧ b ∣ Q ∧ c ∣ Q ∧
    a ≠ b ∧ a ≠ c ∧ b ≠ c ∧ b * c = a * (b + c))

